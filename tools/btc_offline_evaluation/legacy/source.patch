+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <chrono>
+#include <algorithm>
+#include <iomanip>
+#include <rapidjson/document.h>
+#include <rapidjson/stringbuffer.h>
+#include <rapidjson/writer.h>
+#include <sys/resource.h>
+#include <random>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include "rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/MetadataReplay.h"
+#include "rtp_llm/cpp/utils/Logger.h"
+using namespace rtp_llm::benchmark;
+using Clock = std::chrono::steady_clock;
+void require(bool ok, const char* message) {
+    if (!ok)
+        throw std::runtime_error(message);
+}
+rapidjson::Document json(const std::string& s) {
+    rapidjson::Document d;
+    d.Parse(s.c_str());
+    require(!d.HasParseError() && d.IsObject(), "invalid JSON object");
+    return d;
+}
+std::string quoted(const std::string& text) {
+    rapidjson::StringBuffer                    buffer;
+    rapidjson::Writer<rapidjson::StringBuffer> writer(buffer);
+    writer.String(text.data(), static_cast<rapidjson::SizeType>(text.size()));
+    return buffer.GetString();
+}
+struct StageTimes {
+    uint64_t            count{0};
+    double              total{0};
+    std::vector<double> sample;
+    std::mt19937_64     rng{1};
+    void                add(double elapsed) {
+        ++count;
+        total += elapsed;
+        if (sample.size() < 4096)
+            sample.push_back(elapsed);
+        else {
+            auto index = std::uniform_int_distribution<uint64_t>(0, count - 1)(rng);
+            if (index < sample.size())
+                sample[index] = elapsed;
+        }
+    }
+    double quantile(double fraction) const {
+        return sample.at(static_cast<size_t>(std::ceil(fraction * sample.size())) - 1);
+    }
+};
+// BTCPFX01 stores signed base prefix keys in little-endian order.
+template<class T>
+T readScalar(std::istream& input) {
+    T value{};
+    require(bool(input.read(reinterpret_cast<char*>(&value), sizeof(value))), "truncated prepared trace");
+    return value;
+}
+std::string readLabel(std::istream& input) {
+    auto length = readScalar<uint32_t>(input);
+    require(length <= 1048576, "invalid prepared label length");
+    std::string value(length, '\0');
+    require(bool(input.read(value.data(), length)), "truncated prepared label");
+    return value;
+}
+int main(int argc, char** argv) {
+    std::filesystem::path out;
+    bool                  created = false;
+    try {
+        require(argc == 4, "usage: metadata_replay CONFIG.json REQUESTS.jsonl|REQUESTS.btcbin NEW_OUTPUT_DIR");
+        std::ifstream cf(argv[1]);
+        require(bool(cf), "config missing");
+        auto                           d = json(std::string(std::istreambuf_iterator<char>(cf), {}));
+        MetadataReplayConfig           c;
+        std::map<std::string, size_t*> ints = {{"block_tokens", &c.block_tokens},
+                                               {"cp_size", &c.cp_size},
+                                               {"cp_rank", &c.cp_rank},
+                                               {"min_replay_tokens", &c.min_replay_tokens},
+                                               {"device_blocks", &c.device_blocks},
+                                               {"host_blocks", &c.host_blocks},
+                                               {"disk_blocks", &c.disk_blocks},
+                                               {"swa_block_tokens", &c.swa_block_tokens},
+                                               {"swa_blocks", &c.swa_blocks},
+                                               {"last_n", &c.last_n},
+                                               {"linear_step", &c.linear_step},
+                                               {"sliding_window", &c.sliding_window}};
+        for (auto& [key, p] : ints)
+            if (d.HasMember(key.c_str())) {
+                require(d[key.c_str()].IsUint64(), "integer config invalid");
+                *p = d[key.c_str()].GetUint64();
+            }
+        std::map<std::string, double*> floats = {{"device_low", &c.device_low},
+                                                 {"device_high", &c.device_high},
+                                                 {"host_low", &c.host_low},
+                                                 {"host_high", &c.host_high},
+                                                 {"disk_low", &c.disk_low},
+                                                 {"disk_high", &c.disk_high}};
+        for (auto& [key, p] : floats)
+            if (d.HasMember(key.c_str())) {
+                require(d[key.c_str()].IsNumber(), "watermark invalid");
+                *p = d[key.c_str()].GetDouble();
+            }
+        if (d.HasMember("swa")) {
+            require(d["swa"].IsBool(), "swa invalid");
+            c.swa = d["swa"].GetBool();
+        }
+        for (auto pair : {std::make_pair(c.device_low, c.device_high),
+                          std::make_pair(c.host_low, c.host_high),
+                          std::make_pair(c.disk_low, c.disk_high)})
+            require(pair.first >= 0 && pair.second <= 1
+                        && ((pair.first == 0 && pair.second == 0) || pair.first < pair.second),
+                    "invalid watermarks");
+        for (const auto& member : d.GetObject()) {
+            std::string key = member.name.GetString();
+            require(ints.count(key) || floats.count(key) || key == "swa", "unknown config option");
+        }
+        out = argv[3];
+        require(!std::filesystem::exists(out), "output exists");
+        require(std::filesystem::create_directories(out), "output directory already claimed");
+        created = true;
+        rtp_llm::initLogger();
+        MetadataReplay replay(c);
+        std::ifstream  input(argv[2], std::ios::binary);
+        require(bool(input), "trace missing");
+        std::ofstream rows(out / "requests.jsonl");
+        require(bool(rows), "output unavailable");
+        uint64_t                          requests = 0, failed = 0, tokens = 0, hits = 0;
+        std::string                       line, instance;
+        std::map<std::string, StageTimes> stages;
+        const bool                        prepared          = std::filesystem::path(argv[2]).extension() == ".btcbin";
+        uint64_t                          expected_requests = 0, expected_tokens = 0;
+        if (prepared) {
+            uint32_t endian = 1;
+            char     magic[8];
+            require(*reinterpret_cast<char*>(&endian) == 1 && input.read(magic, 8)
+                        && std::memcmp(magic, "BTCPFX01", 8) == 0,
+                    "unsupported prepared format");
+            require(readScalar<uint32_t>(input) == c.block_tokens, "prepared base granularity mismatch");
+            expected_requests = readScalar<uint64_t>(input);
+            expected_tokens   = readScalar<uint64_t>(input);
+            instance          = readLabel(input);
+            require(expected_requests && !instance.empty(), "invalid prepared header");
+        }
+        const auto run_begin = Clock::now();
+        for (;;) {
+            const auto      read_begin = Clock::now();
+            MetadataRequest request;
+            std::string     trace_id;
+            if (prepared) {
+                if (requests == expected_requests)
+                    break;
+                request.id           = static_cast<int64_t>(requests + 1);
+                request.timestamp_ns = readScalar<uint64_t>(input);
+                auto length          = readScalar<uint32_t>(input);
+                require(request.timestamp_ns && length > 0 && length <= std::numeric_limits<int>::max(),
+                        "invalid prepared record");
+                request.input_tokens = static_cast<int>(length);
+                trace_id             = readLabel(input);
+                request.prefix_keys.resize(length / c.block_tokens);
+                if (!request.prefix_keys.empty())
+                    require(bool(input.read(reinterpret_cast<char*>(request.prefix_keys.data()),
+                                            request.prefix_keys.size() * sizeof(int64_t))),
+                            "truncated prepared keys");
+                stages["prepared_read"].add(
+                    std::chrono::duration<double, std::micro>(Clock::now() - read_begin).count());
+            } else {
+                if (!std::getline(input, line))
+                    break;
+                stages["read_line"].add(std::chrono::duration<double, std::micro>(Clock::now() - read_begin).count());
+                const auto parse_begin = Clock::now();
+                auto       r           = json(line);
+                require(r.HasMember("key_form") && r["key_form"].IsString()
+                            && std::string(r["key_form"].GetString()) == "prefix",
+                        "require declared prefix keys; raw hash conversion is not implicit");
+                require(r.HasMember("block_tokens") && r["block_tokens"].IsUint64()
+                            && r["block_tokens"].GetUint64() == c.block_tokens,
+                        "trace base granularity mismatch");
+                require(r.HasMember("input_len") && r["input_len"].IsInt() && r["input_len"].GetInt() > 0,
+                        "input_len missing/invalid");
+                require(r.HasMember("keys") && r["keys"].IsArray(), "keys missing");
+                require(r.HasMember("timestamp_ns") && r["timestamp_ns"].IsUint64(), "timestamp missing");
+                require(r.HasMember("instance_id") && r["instance_id"].IsString(), "instance_id missing");
+                std::string current = r["instance_id"].GetString();
+                require(!current.empty(), "empty instance");
+                if (instance.empty())
+                    instance = current;
+                require(instance == current, "one cache domain per run required");
+                require(r["timestamp_ns"].GetUint64() > 0, "timestamp must be positive");
+                trace_id = std::to_string(requests + 1);
+                if (r.HasMember("request_id")) {
+                    require(r["request_id"].IsString(), "request ID must be a string");
+                    trace_id.assign(r["request_id"].GetString(), r["request_id"].GetStringLength());
+                }
+                request.id           = static_cast<int64_t>(requests + 1);
+                request.timestamp_ns = r["timestamp_ns"].GetUint64();
+                request.input_tokens = r["input_len"].GetInt();
+                for (const auto& key : r["keys"].GetArray()) {
+                    require(key.IsInt64(), "keys must be signed int64 without floating conversion");
+                    request.prefix_keys.push_back(key.GetInt64());
+                }
+                const double parse_us = std::chrono::duration<double, std::micro>(Clock::now() - parse_begin).count();
+                stages["parse_adapt"].add(parse_us);
+            }
+            auto result = replay.run(request);
+            ++requests;
+            tokens += request.input_tokens;
+            failed += !result.success;
+            hits += result.reuse_tokens;
+            for (const auto& [stage, us] : result.stage_us)
+                stages[stage].add(us);
+            auto write_begin = Clock::now();
+            rows << "{\"ordinal\":" << requests << ",\"request_id\":" << quoted(trace_id)
+                 << ",\"timestamp_ns\":" << request.timestamp_ns << ",\"input_tokens\":" << request.input_tokens
+                 << ",\"success\":" << (result.success ? "true" : "false")
+                 << ",\"reuse_tokens\":" << result.reuse_tokens << ",\"status\":\"" << result.status << "\"}\n";
+            require(bool(rows), "row write failed");
+            stages["serialize"].add(std::chrono::duration<double, std::micro>(Clock::now() - write_begin).count());
+        }
+        if (prepared)
+            require(requests == expected_requests && tokens == expected_tokens
+                        && input.peek() == std::char_traits<char>::eof(),
+                    "prepared cohort mismatch");
+        require(input.eof() && !input.bad() && requests > 0, "input failure or empty trace");
+        rows.close();
+        require(bool(rows), "row flush failed");
+        auto          s = replay.stats();
+        struct rusage usage{};
+        require(getrusage(RUSAGE_SELF, &usage) == 0, "RSS query failed");
+        std::ofstream summary(out / "summary.json");
+        summary << std::setprecision(17) << "{\"complete\":true,\"requests\":" << requests
+                << ",\"linear_step\":" << c.linear_step << ",\"linear_step_source\":"
+                << quoted(d.HasMember("linear_step") ? "explicit_override" : "KVCacheConfig default")
+                << ",\"swa_active_tail_blocks\":" << (c.swa ? std::to_string(c.last_n) : "null")
+                << ",\"swa_tail_source\":"
+                << quoted(!c.swa                ? "disabled" :
+                          d.HasMember("last_n") ? "explicit_override" :
+                                                  "SWA group policy default")
+                << ",\"failed_requests\":" << failed << ",\"input_tokens\":" << tokens << ",\"hit_tokens\":" << hits
+                << ",\"hit_rate_all_submitted\":" << double(hits) / tokens
+                << ",\"watermark_round_reports\":" << s.watermark_calls
+                << ",\"watermark_scheduled_blocks\":" << s.watermark_blocks << ",\"force_drop_calls\":" << s.force_calls
+                << ",\"force_drop_reclaimed_blocks\":" << s.force_blocks << ",\"transfers\":" << s.transfers
+                << ",\"failed_transfers\":" << s.failed_transfers << ",\"device_host\":" << s.device_host
+                << ",\"host_disk\":" << s.host_disk << ",\"host_device\":" << s.host_device
+                << ",\"disk_device\":" << s.disk_device << ",\"tree_nodes\":" << s.tree_nodes
+                << ",\"device_used\":" << s.device_used << ",\"host_used\":" << s.host_used
+                << ",\"disk_used\":" << s.disk_used << ",\"kv_payload_bytes_allocated\":" << s.payload_bytes
+                << ",\"physical_copy_attempts\":" << s.copy_attempts
+                << ",\"watermark_check_work_us\":" << s.watermark_ns / 1000.0
+                << ",\"force_drop_work_us\":" << s.force_ns / 1000.0 << ",\"init_us\":" << replay.initMicros()
+                << ",\"run_us\":" << std::chrono::duration<double, std::micro>(Clock::now() - run_begin).count()
+                << ",\"peak_rss_kib\":" << usage.ru_maxrss << ",\"instance_id\":" << quoted(instance)
+                << ",\"stages\":{";
+        bool comma = false;
+        for (auto& [stage, values] : stages) {
+            std::sort(values.sample.begin(), values.sample.end());
+            if (comma)
+                summary << ',';
+            comma = true;
+            summary << quoted(stage) << ":{\"count\":" << values.count << ",\"total_us\":" << values.total
+                    << ",\"mean_us\":" << values.total / values.count
+                    << ",\"quantile_sample_count\":" << values.sample.size() << ",\"p50_us\":" << values.quantile(0.5)
+                    << ",\"p95_us\":" << values.quantile(0.95) << ",\"p99_us\":" << values.quantile(0.99) << "}";
+        }
+        summary << "}}\n";
+        summary.close();
+        require(bool(summary), "summary write failed");
+        std::cout << "complete " << requests << " requests\n";
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << "FAIL: " << e.what() << '\n';
+        if (created) {
+            std::ofstream f(out / "FAILED.txt");
+            f << e.what() << '\n';
+        }
+        return 1;
+    }
+}
diff --git a/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/MetadataReplayTest.cc b/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/MetadataReplayTest.cc
new file mode 100644
index 000000000..37f1fdb3c
--- /dev/null
+++ b/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/MetadataReplayTest.cc
@@ -0,0 +1,56 @@
+#include <iostream>
+#include <type_traits>
+#include "rtp_llm/cpp/cache/block_tree_cache/transfer/BlockTransferDispatcher.h"
+static_assert(std::is_constructible_v<rtp_llm::BlockTransferDispatcher, std::nullptr_t>);
+#include <stdexcept>
+#include "rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/MetadataReplay.h"
+using namespace rtp_llm::benchmark;
+void require(bool condition, const char* message) {
+    if (!condition)
+        throw std::runtime_error(message);
+}
+MetadataRequest request(int id, std::vector<int64_t> keys) {
+    return {id, static_cast<uint64_t>(id), static_cast<int>(keys.size() * 256 + 128), std::move(keys)};
+}
+int main() {
+    MetadataReplayConfig c;
+    c.device_blocks = 32;
+    c.swa_blocks    = 32;
+    MetadataReplay replay(c);
+    auto           a = replay.run(request(1, {1, 2, 3, 4}));
+    auto           b = replay.run(request(2, {1, 2, 3, 4}));
+    require(a.success && a.reuse_tokens == 0, "first miss");
+    require(b.success && b.reuse_tokens == 1024, "repeat hit");
+    MetadataReplay pinned(c);
+    require(pinned.checkPinnedForceDrop(), "pinned force_drop must fail without destroying refs");
+    MetadataReplayConfig f;
+    f.swa           = false;
+    f.device_blocks = 8;
+    f.host_blocks   = 0;
+    f.disk_blocks   = 0;
+    MetadataReplay force(f);
+    require(force.run(request(1, {1, 2, 3, 4})).success, "first allocation");
+    require(force.run(request(2, {11, 12, 13, 14})).success, "force_drop allocation");
+    require(force.stats().force_blocks > 0, "native force_drop must reclaim");
+    MetadataReplayConfig tiered;
+    tiered.swa           = false;
+    tiered.device_blocks = 16;
+    tiered.host_blocks   = 16;
+    tiered.disk_blocks   = 128;
+    tiered.device_low = tiered.host_low = 0.5;
+    tiered.device_high = tiered.host_high = 0.75;
+    MetadataReplay pressure(tiered);
+    for (int j = 0; j < 12; ++j) {
+        int x = j * 100;
+        require(pressure.run(request(j + 1, {x + 1, x + 2, x + 3, x + 4})).success, "pressure fill");
+    }
+    require(pressure.stats().watermark_blocks > 0 && pressure.stats().host_disk > 0, "watermark cascade");
+    pressure.failNextTransfer();
+    auto broken = pressure.run(request(13, {1, 2, 3, 4}));
+    require(!broken.success && broken.status == "load_failed" && broken.reuse_tokens == 0, "injected load failure");
+    auto recovered = pressure.run(request(14, {1, 2, 3, 4}));
+    require(recovered.success && recovered.reuse_tokens == 1024 && pressure.stats().failed_transfers == 1,
+            "successful retry after rollback");
+    std::cout << "PASS watermark cascade, injected load failure, release and recovery\n";
+    std::cout << "PASS basic metadata lifecycle\n";
+}
diff --git a/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/NoPayloadOps.cc b/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/NoPayloadOps.cc
new file mode 100644
index 000000000..20087969c
--- /dev/null
+++ b/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/NoPayloadOps.cc
@@ -0,0 +1,19 @@
+#include <stdexcept>
+#include <atomic>
+#include <cstdint>
+namespace rtp_llm {
+namespace {
+std::atomic<uint64_t> attempts{0};
+}
+namespace benchmark {
+uint64_t physicalCopyAttempts() {
+    return attempts.load();
+}
+}  // namespace benchmark
+struct BatchCopyParams;
+// This executable must never fall through to the physical forward-copy operation.
+void execBatchCopy(const BatchCopyParams&) {
+    ++attempts;
+    throw std::logic_error("physical execBatchCopy is forbidden in metadata replay");
+}
+}  // namespace rtp_llm
diff --git a/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/ResidentReplayMain.cc b/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/ResidentReplayMain.cc
new file mode 100644
index 000000000..26c2e1ee1
--- /dev/null
+++ b/rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/ResidentReplayMain.cc
@@ -0,0 +1,235 @@
+#include <climits>
+// Hold a quiescent native BTC instance between approved, ordered trace segments.
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <limits>
+#include <map>
+#include <sstream>
+#include <thread>
+#include <cstdlib>
+#include <sys/resource.h>
+#include <unistd.h>
+#include <rapidjson/document.h>
+#include "rtp_llm/cpp/cache/block_tree_cache/benchmark/metadata/MetadataReplay.h"
+#include "rtp_llm/cpp/utils/Logger.h"
+using namespace rtp_llm::benchmark;
+namespace fs = std::filesystem;
+using Clock  = std::chrono::steady_clock;
+namespace {
+constexpr uint64_t day_start = 1793030400000000000ULL, day_end = day_start + 86400ULL * 1000000000;
+constexpr uint64_t day_requests = 65740206, chunk_size = 100000;
+void               check(bool ok, const char* msg) {
+    if (!ok)
+        throw std::runtime_error(msg);
+}
+template<class T>
+T scalar(std::istream& f) {
+    T v{};
+    check(bool(f.read(reinterpret_cast<char*>(&v), sizeof(v))), "truncated record");
+    return v;
+}
+std::string label(std::istream& f) {
+    auto n = scalar<uint32_t>(f);
+    check(n <= 1048576, "invalid label size");
+    std::string s(n, '\0');
+    check(bool(f.read(s.data(), n)), "short label");
+    return s;
+}
+void atomicWrite(const fs::path& p, const std::string& s) {
+    auto t = p;
+    t += ".tmp";
+    std::ofstream f(t);
+    f << s << '\n';
+    f.close();
+    check(bool(f), "result write failed");
+    fs::rename(t, p);
+}
+uint64_t through(const fs::path& root) {
+    std::ifstream f(root / "authorized-through");
+    uint64_t      n = 0;
+    check(bool(f >> n) && n <= day_requests && n > 0, "invalid authorized-through");
+    return n;
+}
+MetadataReplayConfig config(const fs::path& path) {
+    std::ifstream       f(path);
+    std::string         body(std::istreambuf_iterator<char>(f), {});
+    rapidjson::Document d;
+    d.Parse(body.c_str());
+    check(!d.HasParseError() && d.IsObject(), "invalid capacity file");
+    const auto& tiers  = d["tiers"];
+    auto usable = [&](const char* tier, const char* group) {
+        const auto& value = tiers[tier][group];
+        check(value.IsInt() && value.GetInt() > 0 && value.GetInt() < INT_MAX, "invalid tier capacity");
+        return value.GetUint();
+    };
+    MetadataReplayConfig c;
+    c.dsv41_topology    = true;
+    c.block_tokens      = 256;
+    c.cp_size           = 4;
+    c.cp_rank           = 0;
+    c.min_replay_tokens = 128;
+    c.swa_block_tokens  = 1024;
+    c.sliding_window    = 128;
+    c.linear_step       = 1;
+    if (d.HasMember("last_n")) {
+        check(d["last_n"].IsUint() && d["last_n"].GetUint() > 0, "invalid last_n");
+        c.last_n = d["last_n"].GetUint();
+    }
+    c.disk_fifo = d.HasMember("disk_fifo") && d["disk_fifo"].GetBool();
+    c.device_blocks = usable("device", "full");
+    c.swa_blocks = usable("device", "swa");
+    c.host_blocks = usable("host", "full");
+    c.host_swa_blocks = usable("host", "swa");
+    c.disk_blocks = usable("disk", "full");
+    c.disk_swa_blocks = usable("disk", "swa");
+    c.device_low  = .82;
+    c.device_high = .90;
+    c.host_low    = .90;
+    c.host_high   = .94;
+    c.disk_low    = .92;
+    c.disk_high   = .97;
+    return c;
+}
+struct Session {
+    fs::path                      input, out;
+    MetadataReplay                engine;
+    Clock::time_point             start = Clock::now();
+    uint64_t                      n = 0, tokens = 0, hits = 0, failed = 0, last_ts = 0, limit = 0;
+    std::map<std::string, double> stages;
+    std::ofstream                 facts;
+    Session(fs::path source, fs::path dest, const MetadataReplayConfig& c):
+        input(source), out(dest), engine(c), limit(through(dest)), facts(dest / "hit-tokens.u32", std::ios::binary) {
+        check(bool(facts), "cannot write hit counters");
+    }
+    std::string state(const char* status) {
+        auto s = engine.stats();
+        check(s.payload_bytes == 0 && s.copy_attempts == 0, "physical backing/copy encountered");
+        struct rusage usage{};
+        getrusage(RUSAGE_SELF, &usage);
+        std::ostringstream o;
+        o << std::setprecision(17) << "{\"status\":\"" << status << "\",\"pid\":" << getpid() << ",\"requests\":" << n
+          << ",\"input_tokens\":" << tokens << ",\"hit_tokens\":" << hits
+          << ",\"hit_rate\":" << (tokens ? double(hits) / tokens : 0) << ",\"failed\":" << failed
+          << ",\"last_timestamp_ns\":" << last_ts << ",\"next_ordinal\":" << n + 1
+          << ",\"next_chunk\":" << n / chunk_size << ",\"chunk_offset\":" << n % chunk_size
+          << ",\"force_drop_blocks\":" << s.force_blocks << ",\"watermark_blocks\":" << s.watermark_blocks
+          << ",\"tree_nodes\":" << s.tree_nodes << ",\"device_used\":" << s.device_used
+          << ",\"host_used\":" << s.host_used << ",\"disk_used\":" << s.disk_used
+          << ",\"failed_transfers\":" << s.failed_transfers << ",\"kv_payload_bytes\":" << s.payload_bytes
+          << ",\"physical_copy_attempts\":" << s.copy_attempts << ",\"max_rss_kib\":" << usage.ru_maxrss
+          << ",\"elapsed_s\":" << std::chrono::duration<double>(Clock::now() - start).count() << ",\"stage_us\":{";
+        bool comma = false;
+        for (auto& v : stages) {
+            if (comma)
+                o << ',';
+            comma = true;
+            o << '"' << v.first << "\":" << v.second;
+        }
+        o << "}}";
+        return o.str();
+    }
+    void boundary() {
+        if (n != limit)
+            return;
+        facts.flush();
+        check(bool(facts), "facts flush failed");
+        auto summary = state("held");
+        atomicWrite(out / ("held-" + std::to_string(n) + ".json"), summary);
+        atomicWrite(out / "progress.json", summary);
+        // Keep the engine, workers, LRU, tier memberships, IDs and input cursor alive.
+        while (limit == n) {
+            std::this_thread::sleep_for(std::chrono::seconds(3));
+            limit = through(out);
+            check(limit >= n, "backward resume forbidden");
+        }
+    }
+    void run() {
+        MetadataRequest q;
+        uint64_t        index = 0;
+        for (;; ++index) {
+            std::ostringstream name;
+            name << std::setw(6) << std::setfill('0') << index << ".btcbin";
+            auto file = input / name.str();
+            while (!fs::exists(file)) {
+                check(!fs::exists(input / "FAILED.json"), "input producer failed");
+                std::this_thread::sleep_for(std::chrono::seconds(2));
+            }
+            std::ifstream f(file, std::ios::binary);
+            char          magic[8];
+            check(bool(f.read(magic, 8)) && !std::memcmp(magic, "BTCPFX01", 8) && scalar<uint32_t>(f) == 256,
+                  "bad chunk header");
+            auto count = scalar<uint64_t>(f), expected = scalar<uint64_t>(f);
+            check(count == std::min<uint64_t>(chunk_size, day_requests - n), "unexpected chunk size");
+            auto domain = label(f);
+            check(!domain.empty(), "empty domain");
+            if (index == 0)
+                atomicWrite(out / "cache-domain.txt", domain);
+            else {
+                std::ifstream df(out / "cache-domain.txt");
+                std::string   first;
+                std::getline(df, first);
+                check(first == domain, "domain changed");
+            }
+            uint64_t chunk_tokens = 0;
+            for (uint64_t i = 0; i < count; ++i) {
+                q.id           = n + 1;
+                q.timestamp_ns = scalar<uint64_t>(f);
+                auto len       = scalar<uint32_t>(f);
+                check(len && len <= std::numeric_limits<int>::max(), "bad token length");
+                q.input_tokens = len;
+                check(q.timestamp_ns >= day_start && q.timestamp_ns < day_end && q.timestamp_ns >= last_ts,
+                      "timestamp outside ordered day");
+                (void)label(f);
+                q.prefix_keys.resize(len / 256);
+                if (!q.prefix_keys.empty())
+                    check(bool(f.read(reinterpret_cast<char*>(q.prefix_keys.data()), 8 * q.prefix_keys.size())),
+                          "truncated base keys");
+                auto result = engine.run(q);
+                check(result.reuse_tokens >= 0 && result.reuse_tokens <= q.input_tokens, "bad hit count");
+                auto hit = static_cast<uint32_t>(result.reuse_tokens);
+                facts.write(reinterpret_cast<const char*>(&hit), sizeof(hit));
+                check(bool(facts), "facts write failed");
+                ++n;
+                failed += !result.success;
+                tokens += len;
+                chunk_tokens += len;
+                hits += hit;
+                last_ts = q.timestamp_ns;
+                for (auto& v : result.stage_us)
+                    stages[v.first] += v.second;
+                if (i + 1 == count)
+                    check(chunk_tokens == expected && f.peek() == std::char_traits<char>::eof(),
+                          "invalid complete chunk");
+                if (n % 10000 == 0)
+                    atomicWrite(out / "progress.json", state("running"));
+                boundary();
+            }
+        }
+    }
+};
+}  // namespace
+int main(int argc, char** argv) {
+    if (argc != 4) {
+        std::cerr << "usage: resident_replay CAPACITY.json CHUNKS NEW_RUN_DIR\n";
+        return 2;
+    }
+    const fs::path out = argv[3];
+    try {
+        check(!fs::exists("/dev/nvidia0") && !fs::exists("/dev/nvidiactl"), "GPU device accessible");
+        check(!fs::exists(out / "progress.json") && !fs::exists(out / "hit-tokens.u32"), "run is not fresh");
+        rtp_llm::initLogger();
+        Session session(argv[2], out, config(argv[1]));
+        atomicWrite(out / "progress.json", session.state("starting"));
+        session.run();
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        if (!fs::exists(out / "FAILED.txt"))
+            atomicWrite(out / "FAILED.txt", e.what());
+        return 1;
+    }
+    return 0;
+}
