+"""Export the pinned model's native descriptor assignments. Run in an RTP-LLM environment."""
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+from rtp_llm.models.dsv41_kv_cache import build_v41_kv_cache_spec_descs
+from rtp_llm.models.dsv4_kv_cache import apply_dsv4_explicit_pool_blocks
+
+
+def enum(value, kind):
+    name = value.name
+    if kind == "KVCacheSpecType":
+        name = {"OPAQUE_KV": "OpaqueKV", "OPAQUE_STATE": "OpaqueState"}[name]
+    return f"{kind}::{name}"
+
+
+def render(config_path):
+    data = Path(config_path).read_bytes()
+    model = json.loads(data)["text_config"]
+    target = build_v41_kv_cache_spec_descs(
+        model["num_hidden_layers"], model["compress_ratios"], model["kv_source_layer_ids"],
+        model["head_dim"], bounded_replay=True,
+    )
+    draft = build_v41_kv_cache_spec_descs(
+        model["num_nextn_predict_layers"], model["compress_ratios"][len(target):], [],
+        model["head_dim"], bounded_replay=True, draft=True,
+    )
+    # last-n-20261029/online-pools.json, explicit setting including reserved block zero.
+    apply_dsv4_explicit_pool_blocks(target + draft, "decoder_swa_kv", 1024)
+    prototypes = {desc.tag: desc for layer in target + draft for desc in layer}
+    print("// Generated by export_dsv41_profile.py from model-config.json SHA256")
+    print("// " + hashlib.sha256(data).hexdigest())
+    print('#pragma once\n#include "rtp_llm/cpp/cache/KVCacheSpecDesc.h"')
+    print("#include <vector>\nnamespace rtp_llm::benchmark::dsv41 {")
+    print(f"constexpr int kWindow = {model['sliding_window']};")
+    print(f"constexpr int kDraftBlockSize = {model['dspark_block_size']};")
+    print("inline std::vector<KVCacheSpecDesc> descriptors() {")
+    for tag, desc in prototypes.items():
+        print(f"    KVCacheSpecDesc {tag};")
+        fields = dict(
+            tag=json.dumps(tag), cache_type=enum(desc.cache_type, "KVCacheSpecType"),
+            dtype=enum(desc.dtype, "DataType"), entry_dtype=enum(desc.entry_dtype, "DataType"),
+            entry_count_mode=enum(desc.entry_count_mode, "OpaqueBlockEntryCountMode"),
+            entry_elems=desc.entry_elems, compression_ratio=desc.compression_ratio,
+        )
+        for key in ("is_state_cache", "state_ring_include_gen_num_per_cycle", "state_ring_overlap",
+                    "block_stride_alignment_min_entries", "block_stride_bytes_alignment"):
+            if value := getattr(desc, key):
+                fields[key] = str(value).lower()
+        if desc.cp is not None:
+            fields.update({"cp": "CacheCpPolicyDesc{}", "cp->align_payload": str(desc.cp.align_payload).lower(),
+                           "cp->scale_seq_size": str(desc.cp.scale_seq_size).lower(),
+                           "cp->prefill_slice_layout": enum(desc.cp.prefill_slice_layout, "CpPrefillSliceLayout"),
+                           "cp->slice": enum(desc.cp.slice, "CpBlockSliceMode")})
+        if desc.reuse is not None and desc.reuse.enable_prefix_reuse is not None:
+            fields["reuse"] = "CacheReusePolicyDesc{" + str(desc.reuse.enable_prefix_reuse).lower() + "}"
+        if desc.capacity is not None:
+            fields.update({"capacity": "CacheCapacityPolicyDesc{}",
+                           "capacity->explicit_block_num": desc.capacity.explicit_block_num,
+                           "capacity->charge_to_paged_budget": str(desc.capacity.charge_to_paged_budget).lower()})
+        for key, value in fields.items():
+            print(f"    {tag}.{key} = {value};")
+    print("    return {" + ", ".join(prototypes) + "};\n}")
+    for name, layers in (("target", target), ("draft", draft)):
+        print(f"inline std::vector<std::vector<std::string>> {name}Layers() {{\n    return {{")
+        for layer in layers:
+            print("        {" + ", ".join(json.dumps(d.tag) for d in layer) + "},")
+        print("    };\n}")
+    print("}  // namespace rtp_llm::benchmark::dsv41")
+
+
+if __name__ == "__main__":
+    render(sys.argv[1])
